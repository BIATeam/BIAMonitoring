{
  "BiaNet": {
    "Environment": {
      "Type": "DEV",
      // UrlMatomo shoulld now contain the name of the php and js (originaly matomo.js & matomo.php) => rename to bypass ublock
      "UrlMatomo": "https://matomo-int.the-shared-tools-domain-name.bia/matomo(torename)",
      "SiteIdMatomo": "1"
    },
    "CommonFeatures": {
      "ClientForHub": {
        "SignalRUrl": "http://localhost/BIAMonitoring/WebApi/HubForClients"
      }
    },
    "ApiFeatures": {
      "Swagger": {
        "IsActive": true
      },
      "DelegateJobToWorker": {
        "MonitoringUrl": "http://localhost/BIAMonitoring/WebApi/hangfire"
      }
    },
    "Security": {
      "Audience": "http://localhost:4200"
    },
    "EmailConfiguration": {
      "From": "noreply-BIAMonitoring@the-mail-domain.bia",
      "SmtpHost": "127.0.0.1",
      "SmtpPort": 25
    },
    "Authentication": {
      "Keycloak": {
        "IsActive": false,
        "BaseUrl": "http://localhost:8080",
        "Configuration": {
          "idpHint": "darwin",
          "realm": "BIA-Realm",
          "Authority": "/realms/BIA-Realm",
          "RequireHttpsMetadata": false,
          "ValidAudience": "account"
        },
        "Api": {
          "TokenConf": {
            "RelativeUrl": "/realms/BIA-Realm/protocol/openid-connect/token",
            "ClientId": "biamonitoring",
            "GrantType": "password",
            "CredentialSource": {
              "VaultCredentialsKey": "BIA:KeycloakSearchUserAccount",
              "EnvLoginKey": "KC_SA_USERNAME",
              "EnvPasswordKey": "KC_SA_PASSWORD"
            }
          },
          "SearchUserRelativeUrl": "/admin/realms/BIA-Realm/users"
        }
      },
      "LdapDomains": [
        {
          "Name": ".",
          "LdapName": ".",
          "ContainsGroup": true,
          "ContainsUser": true
        }
      ]
    },
    "Roles": [
      {
        "Label": "User",
        "Type": "Fake"
      },
      {
        "Label": "Admin",
        "Type": "Fake"
      }
    ],
    "UserProfile": {
      //remove url for faster debug
      "url": ""
    },
    "ProfileConfiguration": {
      // Determine if the client browser get the profile image from the URL or Path (when true) or if the client calls the api to get the image instead (when false)
      "ClientProfileImageGetMode": false,
      "ProfileImageUrlOrPath": "https://mycompany.human-resources.com/Profile/{login}/Picture",
      "EditProfileImageUrl": "https://mycompany.human-resources.com/Profile/Edit"
    },
    "PermissionsByEnv": [
      {
        "Names": [
          "User_ListAD",
          "User_Add",
          "User_Delete",
          "User_Save"
        ],
        "Roles": [
          "Admin"
        ]
      },
      {
        "Names": [
          "User_List_Access",
          "User_List",
          "User_Read",
          "User_Sync",
          "User_UpdateRoles"
        ],
        "Roles": [
          "Admin"
        ]
      },
      {
        "Names": [
          "User_UpdateRoles"
        ],
        "Roles": [
          "Admin"
        ]
      },
      {
        "Names": [
          "User_ListAD",
          "User_Add",
          "User_Save"
        ],
        "Roles": [
          "Site_Admin"
        ]
      }
    ]
  }
}